# Локальная разработка - ИСПОЛЬЗУЙТЕ ЭТОТ ФАЙЛ ДЛЯ LOCAL DEVELOPMENT
# Скопируйте в .env.local и заполните реальные значения

# Базовые настройки
VITE_API_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Безопасность - ОБЯЗАТЕЛЬНО ЗАМЕНИТЕ!
AURION_SECRET_KEY=your-super-secret-key-here-min-32-chars
AURION_DB_PATH=./data/aurion.db

# Авторизация
AURION_ACCESS_TOKEN_TTL_MINUTES=60
AURION_REFRESH_TOKEN_TTL_DAYS=30
AURION_2FA_CHALLENGE_TTL_MINUTES=10

# Rate limiting
AURION_LOGIN_RATE_LIMIT_ATTEMPTS=8
AURION_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
AURION_LOGIN_RATE_LIMIT_BLOCK_SECONDS=600

# Учетная запись основателя - ЗАМЕНИТЕ НА РЕАЛЬНЫЕ
AURION_FOUNDER_EMAIL=your-email@example.com
AURION_FOUNDER_USERNAME=your-username
AURION_FOUNDER_PASSWORD=your-secure-password

# Создатели системы
AURION_CREATOR_EMAILS=your-email@example.com

# Внешние API ключи (по желанию)
QUANTUM_RINGS_TOKEN=
YANDEX_FOLDER_ID=
YANDEX_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
SHODAN_API_KEY=
APIFY_API_TOKEN=
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
GOOGLE_FIT_CLIENT_ID=
GOOGLE_FIT_CLIENT_SECRET=
REPLICATE_API_TOKEN=
HUGGINGFACE_API_TOKEN=
ELEVENLABS_API_KEY=
PLANET_API_KEY=
REDIS_URL=
DATABASE_URL=
HPC_UNICORE_URL=
HPC_UNICORE_USER=
HPC_UNICORE_PASSWORD=
MQTT_HOST=
IBM_QUANTUM_TOKEN=
IBM_QUANTUM_INSTANCE=
IBM_QUANTUM_API_URL=
PASQAL_API_TOKEN=
PASQAL_API_URL=
ALIBABA_QUANTUM_TOKEN=
ALIBABA_QUANTUM_API_URL=
