# ============================================================
# Aurion OS — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# Environment: development | staging | production
ENVIRONMENT=development

# ============================================================
# Database
# ============================================================
# Local dev (SQLite — no setup needed):
DATABASE_URL=sqlite+aiosqlite:///./aurion.db
# Production (PostgreSQL — required on Railway):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/aurion

# ============================================================
# Redis
# ============================================================
REDIS_URL=redis://localhost:6379/0

# ============================================================
# Security (CHANGE IN PRODUCTION!)
# ============================================================
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================
# CORS
# ============================================================
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://aurionai.ru

# ============================================================
# Quantum Computing
# ============================================================
# ✅ REAL KEY — IonQ/Rigetti via Quantum Rings SDK
QUANTUM_RINGS_TOKEN=s_977d151d919a41738625077677c3723f
# ⚠️ STUB — get at quantum-computing.ibm.com
IBM_QUANTUM_TOKEN=
# ⚠️ STUB — optional, emulator works without key
PASQAL_TOKEN=

# ============================================================
# AI / LLM
# ============================================================
# ⚠️ STUB — get at platform.openai.com
OPENAI_API_KEY=
# ⚠️ STUB — get at console.anthropic.com
ANTHROPIC_API_KEY=

# ============================================================
# Yandex Cloud (SpeechKit, YandexGPT, Maps)
# ============================================================
# ⚠️ STUB — get at console.yandex.cloud
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_IAM_TOKEN=

# ============================================================
# Voice / TTS
# ============================================================
# ⚠️ STUB — get at elevenlabs.io | FALLBACK: edge-tts (free)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_STABILITY=0.75
ELEVENLABS_SIMILARITY_BOOST=0.85
ELEVENLABS_STYLE=0.2

# ============================================================
# OSINT (all optional — mock data used if not set)
# ============================================================
CENSYS_API_ID=
CENSYS_API_SECRET=
SHODAN_API_KEY=
APIFY_API_TOKEN=

# ============================================================
# Satellite (NASA GIBS is free, no key needed)
# ============================================================
# ⚠️ STUB — requires paid subscription at planet.com
PLANET_API_KEY=

# ============================================================
# Payments
# ============================================================
# ⚠️ STUB — register at yookassa.ru
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# ============================================================
# Health / Wearables (OAuth2 — optional)
# ============================================================
GOOGLE_FIT_CLIENT_ID=
GOOGLE_FIT_CLIENT_SECRET=
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=

# ============================================================
# Telegram Bot
# ============================================================
# ⚠️ STUB — create bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# ============================================================
# Creative (image/music generation)
# ============================================================
REPLICATE_API_TOKEN=
HUGGINGFACE_TOKEN=

# ============================================================
# Frontend (Vite)
# ============================================================
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# ============================================================
# Logging
# ============================================================
LOG_LEVEL=INFO
